              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Spatial Metric"
        },
        "taxonomy": {
          "anyOf": [
            {
              "enum": [
                "category",
                "event_type",
                "genre"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Taxonomy"
        },
        "temporal": {
          "$ref": "#/$defs/ConversationTemporal"
        }
