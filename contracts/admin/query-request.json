        "intent": {
          "enum": [
            "aggregate",
            "count",
            "list",
            "rank",
            "recommend",
            "search",
            "spatial_rank",
            "taxonomy"
          ],
          "title": "Intent",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
