        "filters": {
          "$ref": "#/$defs/ConversationNames"
        },
        "groupings": {
          "items": {
            "enum": [
              "category",
              "country",
              "district",
              "event",
              "event_type",
              "genre",
              "month",
              "municipality",
              "organization",
              "region",
              "state",
              "venue",
              "weekday"
