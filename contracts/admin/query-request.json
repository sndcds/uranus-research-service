{
  "$defs": {
    "ConversationArea": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "relation": {
          "enum": [
            "inside",
            "outside"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "relation"
      ],
      "title": "ConversationArea",
      "type": "object"
    },
    "ConversationAreaV12": {
      "additionalProperties": false,
      "properties": {
        "expected_level": {
          "anyOf": [
            {
              "enum": [
                "country",
                "district",
                "municipality",
                "region",
                "state"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Level"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "relation": {
          "enum": [
            "inside",
            "outside"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "name",
        "relation",
        "expected_level"
      ],
      "title": "ConversationAreaV12",
      "type": "object"
    },
    "ConversationNames": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Categories",
          "type": "array"
        },
        "event_types": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Event Types",
          "type": "array"
        },
        "genres": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Genres",
          "type": "array"
        },
        "organization": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Organization"
        },
        "venue": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue"
        }
      },
      "required": [
        "venue",
        "organization",
        "event_types",
        "categories",
        "genres"
      ],
      "title": "ConversationNames",
      "type": "object"
    },
    "ConversationTemporal": {
      "additionalProperties": false,
      "properties": {
        "from_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Date"
        },
        "months": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 12,
          "title": "Months",
          "type": "array"
        },
        "period": {
          "enum": [
            "explicit_range",
            "future",
            "next_week",
            "none",
            "past",
            "this_month",
            "this_weekend",
            "this_year",
            "today",
            "tomorrow"
          ],
          "title": "Period",
          "type": "string"
        },
        "time_of_day": {
          "enum": [
            "afternoon",
            "evening",
            "morning",
            "night",
            "none"
          ],
          "title": "Time Of Day",
          "type": "string"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Date"
        },
        "weekdays": {
          "items": {
            "maximum": 7,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 7,
          "title": "Weekdays",
          "type": "array"
        }
      },
      "required": [
        "period",
        "from_date",
        "to_date",
        "time_of_day",
        "weekdays",
        "months"
      ],
      "title": "ConversationTemporal",
      "type": "object"
    },
    "LocationContext": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "source": {
          "enum": [
            "browser_geolocation",
            "manual",
            "nominatim_reverse"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "LocationContext",
      "type": "object"
    },
    "ResearchConversationContext": {
      "additionalProperties": false,
      "properties": {
        "previous_turns": {
          "items": {
            "$ref": "#/$defs/ResearchPlanSummary"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Previous Turns",
          "type": "array"
        }
      },
      "required": [
        "previous_turns"
      ],
      "title": "ResearchConversationContext",
      "type": "object"
    },
