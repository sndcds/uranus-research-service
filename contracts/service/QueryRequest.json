{
  "$defs": {
    "LocationContext": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "source": {
          "enum": [
            "browser_geolocation",
            "manual",
            "nominatim_reverse"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "LocationContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "language": {
      "default": "auto",
      "enum": [
        "auto",
        "da",
        "de",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "location_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocationContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "query": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "timezone": {
      "default": "Europe/Berlin",
      "maxLength": 64,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "title": "QueryRequest",
  "type": "object"
}
