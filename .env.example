# Explicit supervisor environment only; no implicit dotenv loading.
# Prefer absolute protected files. Never use Admin writer or production test credentials.
RESEARCH_API_KEY_FILE=/run/secrets/research_api_key
PLANNER_API_KEY_FILE=/run/secrets/planner_api_key
RESEARCH_DATABASE_URL_FILE=/run/secrets/source_reader_url
RESEARCH_AREA_DATABASE_URL_FILE=/run/secrets/area_reader_url
# Reader files contain a postgresql+asyncpg:// URL; privileges are checked at runtime.
# Local process example. Containers need reachable fixed HTTPS service origins.
PLANNER_URL=http://127.0.0.1:6334
PLANNER_CONTRACT=v13
EVENT_TIMEZONE=Europe/Berlin
URANUS_TIMESTAMP_TIMEZONE=UTC
DB_TIMEOUT_SECONDS=10
DB_POOL_SIZE=4
DEPENDENCY_TIMEOUT_SECONDS=5
MAX_RESPONSE_BYTES=65536
MAX_CONCURRENT_REQUESTS=4
BODY_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=25
# Optional capabilities; missing dependencies fail closed for affected queries.
# RESEARCH_GEOCODER_URL=http://127.0.0.1:6337
# RESEARCH_GEOCODER_API_KEY_FILE=/run/secrets/geocoder_api_key
# RESEARCH_ADMINISTRATIVE_CATALOG_PATH=/run/research/administrative-catalog.json
# Encoder/Qdrant are not part of Phase-2A query or readiness.

# Optional semantic readiness only; never enables public semantic /query.
# QDRANT_URL=http://127.0.0.1:16333
# QDRANT_API_KEY_FILE=/protected/qdrant-key
# SEMANTIC_BUILD_ID=test_reviewed
