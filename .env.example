# Explicit supervisor environment only; no implicit dotenv loading.
# Prefer absolute paths to protected, separately provisioned key files.
RESEARCH_API_KEY_FILE=/run/secrets/research_api_key
PLANNER_API_KEY_FILE=/run/secrets/planner_api_key
ENCODER_API_KEY_FILE=/run/secrets/encoder_api_key
# Direct local process example. Containers need reachable fixed origins; see compose.
PLANNER_URL=http://127.0.0.1:6334
ENCODER_URL=http://127.0.0.1:6335
PLANNER_CONTRACT=v13
DEPENDENCY_TIMEOUT_SECONDS=5
MAX_RESPONSE_BYTES=65536
MAX_CONCURRENT_REQUESTS=4
BODY_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=25
